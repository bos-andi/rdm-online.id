APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ADMIN_EMAIL=
ADMIN_PASSWORD=

DEPLOY_BASE_PATH=/var/www/rdm-online
DEPLOY_SERVER_IP=
DEPLOY_CERTBOT_EMAIL=admin@rdm-online.id
DEPLOY_SSH_PRIVATE_KEY=
DEPLOY_REMOTE_SCRIPT=/opt/rdm-online/scripts/rdm-deploy.sh
DEPLOY_REMOTE_SOURCE_ZIP=/opt/rdm-online/RDMhosting.zip
DEPLOY_REMOTE_SQL_TEMPLATE=/opt/rdm-online/storage/deploy/rdm-base.sql

SUBSCRIPTION_GRACE_DAYS=30
SUBSCRIPTION_PURGE_WARNING_DAYS=7
DEPLOY_DB_HOST=127.0.0.1
DEPLOY_DB_ADMIN_USER=root
DEPLOY_DB_ADMIN_PASSWORD=

HOSTINGER_API_TOKEN=
HOSTINGER_API_BASE=https://developers.hostinger.com

XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_API_URL=https://api.xendit.co

# Gateway untuk transaksi baru: andidev | tripay | xendit
PAYMENT_GATEWAY=andidev
# https://payment.andidev.id/docs
ANDIDEV_PAY_URL=https://payment.andidev.id
ANDIDEV_PAY_KEY=
ANDIDEV_PAY_WEBHOOK_SECRET=

# Tripay hanya untuk transaksi lama
TRIPAY_MODE=sandbox
TRIPAY_MERCHANT_CODE=
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

COMPANY_EMAIL=admin@rdm-online.id
COMPANY_WHATSAPP=628123456789
COMPANY_ADDRESS=
